# ---- 必填 ----
# openssl rand -hex 24 生成；只存服务端 .env 与手机本机 DataStore
IMAGE_EDIT_TOKEN=please-change-me

# ---- 后端 ----
# mock      不加载模型，返回占位图（联调用）
# comfyui   调用本机已跑起来的 ComfyUI（GGUF 量化版，24GB 显存的推荐路线）
# diffusers 本机 ROCm + QwenImageEditPlusPipeline（需要足够内存放下 bf16 权重）
BACKEND=comfyui
MODEL_NAME=Qwen/Qwen-Image-Edit-2511

# BACKEND=comfyui
COMFY_URL=http://127.0.0.1:8188
COMFY_UNET=qwen-image-edit-2511-Q4_K_M.gguf
COMFY_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
COMFY_VAE=qwen_image_vae.safetensors
COMFY_SHIFT=3.1
COMFY_SAMPLER=euler
COMFY_SCHEDULER=simple
# 首次加载 GGUF + 文本编码器会慢；闲置唤醒也要等模型加载
COMFY_TIMEOUT=1500

# BACKEND=diffusers
# 本地权重目录（指向模型根目录）
MODEL_PATH=
# bf16 / fp16 / fp8 / fp32
MODEL_DTYPE=bf16
# none / model / sequential；显存不足时用 sequential（更慢）
MODEL_OFFLOAD=model
MODEL_DEVICE=cuda

# ---- 提示词优化（可选）----
# none / llama / openai
# llama   进程内 llama.cpp 直接读 GGUF，无需额外服务；常驻约 2GB 内存，不占显存
# openai  走 OpenAI 兼容接口（Ollama 用 http://127.0.0.1:11434/v1）
PROMPT_OPTIMIZER=none

# PROMPT_OPTIMIZER=llama
PROMPT_LLM_GGUF=/home/ubuntu/models/rewrite-llm-q4.gguf
# CPU 线程数（ComfyUI 在跑时别占满，留给采样）
PROMPT_LLM_THREADS=4
PROMPT_LLM_CTX=2048
# 想借用显存就调成 99，但会和 ComfyUI 抢 24GB 显存
PROMPT_LLM_GPU_LAYERS=0

# PROMPT_OPTIMIZER=openai
OPTIMIZER_URL=http://127.0.0.1:11434/v1
OPTIMIZER_MODEL=qwen2.5:3b-instruct
OPTIMIZER_TIMEOUT=20
OPTIMIZER_MAX_CHARS=800

# ---- 队列与限制 ----
MAX_CONCURRENCY=1
MAX_QUEUE=12
MAX_REFS=3
MAX_BATCH=8
MAX_INPUT_MB=20
MAX_SIDE=2048
# 首次用 ComfyUI 要加载 GGUF + 文本编码器，单张可能 3–5 分钟；叠加上闲置唤醒，超时要放宽
JOB_TIMEOUT_SECONDS=1200
SYNC_WAIT_SECONDS=240
CACHE_ENABLED=1

# ---- 存储与清理 ----
RESULT_DIR=/data/results
INPUT_DIR=/data/inputs
JOBS_DB=/data/jobs.sqlite
RESULT_TTL_HOURS=168
JOB_RETENTION_DAYS=30
RESULT_MAX_GB=20
